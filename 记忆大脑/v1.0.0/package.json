{
  "name": "dsh-brain",
  "version": "0.1.0",
  "description": "DSH 记忆大脑：四层记忆体系 + 每轮检索注入 + 自动接续 + 左侧边栏记忆面板",
  "type": "module",
  "main": "src/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "handoff",
    "sage-mem"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
